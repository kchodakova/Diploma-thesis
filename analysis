import pandas as pd
from scipy.stats import mannwhitneyu

# ============================================================
# EVENT PERIODS VS NON-EVENT PERIODS
# Mann-Whitney U test
# Period: 2022-01-01 to 2024-12-31
# Variable: daily_sales
# ============================================================

print("SCRIPT STARTED")

# Load data
file_path = r"C:\Users\kajka\Documents\Diplomka\Dáta\Used data\daily_sales_series_2022_2024.csv"
df = pd.read_csv(file_path)

# Column names
date_col = "transaction_date"
revenue_col = "daily_sales"

# Prepare columns
df[date_col] = pd.to_datetime(df[date_col], errors="coerce")
df[revenue_col] = pd.to_numeric(df[revenue_col], errors="coerce")

# Remove missing values
df = df.dropna(subset=[date_col, revenue_col]).copy()

# Filter analysed period
df = df[
    (df[date_col] >= "2022-01-01") &
    (df[date_col] <= "2024-12-31")
].copy()

# Create date variables
df["year"] = df[date_col].dt.year
df["month"] = df[date_col].dt.month
df["day"] = df[date_col].dt.day

# Normalize daily sales within each year
# This reduces the influence of the overall decline in revenue across years
df["year_avg_revenue"] = df.groupby("year")[revenue_col].transform("mean")
df["revenue_index"] = df[revenue_col] / df["year_avg_revenue"] * 100

# ============================================================
# DEFINE EVENT PERIODS
# ============================================================

# Pre-Christmas: 1 December to 23 December
df["pre_christmas"] = (
    (df["month"] == 12) &
    (df["day"] >= 1) &
    (df["day"] <= 23)
)

# Black Friday to Cyber Monday windows
black_friday_dates = pd.to_datetime([
    "2022-11-25", "2022-11-26", "2022-11-27", "2022-11-28",
    "2023-11-24", "2023-11-25", "2023-11-26", "2023-11-27",
    "2024-11-29", "2024-11-30", "2024-12-01", "2024-12-02"
])

df["black_friday"] = df[date_col].isin(black_friday_dates)

# Post-Christmas windows
# 2022 window: 25 Dec 2022 to 7 Jan 2023
# 2023 window: 25 Dec 2023 to 7 Jan 2024
# 2024 window is incomplete because Jan 2025 is not in the dataset, so it is excluded from statistical testing
post_christmas_2022 = (
    (df[date_col] >= "2022-12-25") &
    (df[date_col] <= "2023-01-07")
)

post_christmas_2023 = (
    (df[date_col] >= "2023-12-25") &
    (df[date_col] <= "2024-01-07")
)

df["post_christmas"] = post_christmas_2022 | post_christmas_2023

# Assign event year for post-Christmas
# The event year is the year of December, not January
df["post_christmas_event_year"] = None
df.loc[post_christmas_2022, "post_christmas_event_year"] = 2022
df.loc[post_christmas_2023, "post_christmas_event_year"] = 2023

# Mark all defined event days
df["any_event"] = (
    df["pre_christmas"] |
    df["black_friday"] |
    df["post_christmas"]
)

# ============================================================
# FUNCTION FOR EVENT VS NON-EVENT TESTS
# ============================================================

def mann_whitney_event_test(data, event_name, event_col, event_year, year_col="year"):
    """
    Compares event days with non-event days in the corresponding year.
    Uses revenue_index to reduce the influence of different annual revenue levels.
    """

    # Event days
    if event_name == "Post-Christmas":
        event_data = data[
            (data[event_col] == True) &
            (data["post_christmas_event_year"] == event_year)
        ].copy()

        # Reference period: non-event days in the December year of the event
        reference_data = data[
            (data["year"] == event_year) &
            (data["any_event"] == False)
        ].copy()

    else:
        event_data = data[
            (data[event_col] == True) &
            (data[year_col] == event_year)
        ].copy()

        # Reference period: non-event days in the same year
        reference_data = data[
            (data[year_col] == event_year) &
            (data["any_event"] == False)
        ].copy()

    event_values = event_data["revenue_index"].dropna()
    non_event_values = reference_data["revenue_index"].dropna()

    # Skip test if there are not enough observations
    if len(event_values) < 2 or len(non_event_values) < 2:
        return {
            "Event": event_name,
            "Year": event_year,
            "Event days": len(event_values),
            "Non-event days": len(non_event_values),
            "Event avg revenue": None,
            "Non-event avg revenue": None,
            "Difference (%)": None,
            "U statistic": None,
            "p-value": None,
            "Conclusion": "Not enough observations"
        }

    # Mann-Whitney U test
    u_stat, p_value = mannwhitneyu(
        event_values,
        non_event_values,
        alternative="two-sided"
    )

    # Averages in original revenue
    event_avg_revenue = event_data[revenue_col].mean()
    non_event_avg_revenue = reference_data[revenue_col].mean()

    difference_pct = ((event_avg_revenue / non_event_avg_revenue) - 1) * 100

    if p_value < 0.001:
        p_display = "< 0.001"
    else:
        p_display = round(p_value, 4)

    conclusion = (
        "Statistically significant"
        if p_value < 0.05
        else "Not statistically significant"
    )

    return {
        "Event": event_name,
        "Year": event_year,
        "Event days": len(event_values),
        "Non-event days": len(non_event_values),
        "Event avg revenue": round(event_avg_revenue, 2),
        "Non-event avg revenue": round(non_event_avg_revenue, 2),
        "Difference (%)": round(difference_pct, 2),
        "U statistic": round(u_stat, 3),
        "p-value": p_display,
        "Conclusion": conclusion
    }

# ============================================================
# RUN TESTS
# ============================================================

results = []

# Pre-Christmas: 2022, 2023, 2024
for year in [2022, 2023, 2024]:
    results.append(
        mann_whitney_event_test(
            data=df,
            event_name="Pre-Christmas",
            event_col="pre_christmas",
            event_year=year
        )
    )

# Post-Christmas: only fully observed windows 2022 and 2023
# 2024 is excluded because Jan 2025 is not available
for year in [2022, 2023]:
    results.append(
        mann_whitney_event_test(
            data=df,
            event_name="Post-Christmas",
            event_col="post_christmas",
            event_year=year
        )
    )

# Black Friday: 2022, 2023, 2024
for year in [2022, 2023, 2024]:
    results.append(
        mann_whitney_event_test(
            data=df,
            event_name="Black Friday",
            event_col="black_friday",
            event_year=year
        )
    )

event_test_results = pd.DataFrame(results)

# ============================================================
# PRINT RESULTS
# ============================================================

print("\nEvent vs non-event Mann-Whitney U test results:")
print(event_test_results.to_string(index=False))

print("\nNotes:")
print("1. The test variable is year-normalized daily revenue.")
print("2. Event averages and non-event averages are reported in original revenue values.")
print("3. Non-event days exclude all defined event periods.")
print("4. The post-Christmas 2024 window is excluded because January 2025 is not available.")
print("5. Black Friday 2024 includes 1-2 December 2024, which overlaps with the beginning of the pre-Christmas period.")

print("\nHotovo.")

from pathlib import Path
import pandas as pd
import numpy as np
from prophet import Prophet

# =========================
# 1. CESTA K PRIPRAVENYM DATAM
# =========================
input_path = Path(r"C:\Users\kajka\Documents\Diplomka\Dáta\Used data\b_segment_forecast_input.csv")

# =========================
# 2. NACITANIE DAT
# =========================
df = pd.read_csv(input_path, encoding="utf-8-sig")

print("\n--- NACITANIE PRIPRAVENYCH DAT ---")
print("Pocet riadkov:", len(df))
print("Stlpce:", df.columns.tolist())

required_cols = {"transaction_date", "line_total"}
missing_cols = required_cols - set(df.columns)

if missing_cols:
    raise ValueError(f"V subore chybaju stlpce: {missing_cols}")

# =========================
# 3. PARSOVANIE
# =========================
df["transaction_date"] = pd.to_datetime(
    df["transaction_date"].astype(str).str.strip(),
    format="%Y-%m-%d",
    errors="coerce"
)

df["line_total"] = pd.to_numeric(df["line_total"], errors="coerce")

print("\n--- KONTROLA PO PARSOVANI ---")
print("Neparsovane datumy:", df["transaction_date"].isna().sum())
print("Neparsovane line_total:", df["line_total"].isna().sum())

df = df.dropna(subset=["transaction_date", "line_total"]).copy()

if df.empty:
    raise ValueError("Po parsovani nezostali ziadne riadky.")

# =========================
# 4. TRAIN A ACTUAL 2024
# =========================
train_raw = df[df["transaction_date"] < "2024-01-01"].copy()
actual_2024_raw = df[
    (df["transaction_date"] >= "2024-01-01") &
    (df["transaction_date"] <= "2024-12-31")
].copy()

print("\n--- ROZDELENIE DAT ---")
print("Train riadky (2022-2023):", len(train_raw))
print("Actual 2024 riadky:", len(actual_2024_raw))

if train_raw.empty:
    raise ValueError("Train dataset je prazdny.")

if actual_2024_raw.empty:
    raise ValueError("Actual 2024 dataset je prazdny.")

# =========================
# 5. DENNA CASOVA RADA PRE PROPHET
# =========================
train_daily = (
    train_raw.assign(ds=train_raw["transaction_date"].dt.normalize())
    .groupby("ds", as_index=False)["line_total"]
    .sum()
    .rename(columns={"line_total": "y"})
)

full_train_dates = pd.DataFrame({
    "ds": pd.date_range(start=train_daily["ds"].min(), end="2023-12-31", freq="D")
})

train_daily = full_train_dates.merge(train_daily, on="ds", how="left")
train_daily["y"] = train_daily["y"].fillna(0)

print("\n--- DENNA CASOVA RADA PRE PROPHET PRED LOG TRANSFORMACIOU ---")
print("Pocet riadkov:", len(train_daily))
print("Obdobie:", train_daily["ds"].min(), "->", train_daily["ds"].max())
print(train_daily.head())

# log transformacia
train_daily["y"] = np.log1p(train_daily["y"])

print("\n--- DENNA CASOVA RADA PRE PROPHET PO LOG TRANSFORMACII ---")
print(train_daily.head())

# =========================
# 6. ACTUAL 2024 NA MESACNEJ UROVNI
# =========================
actual_2024_raw["month"] = actual_2024_raw["transaction_date"].dt.to_period("M").dt.to_timestamp()

actual_2024 = (
    actual_2024_raw.groupby("month", as_index=False)["line_total"]
    .sum()
    .rename(columns={"line_total": "actual_sales"})
    .sort_values("month")
    .reset_index(drop=True)
)

print("\n--- ACTUAL 2024 ---")
print(actual_2024)

# =========================
# 7. CUSTOM HOLIDAYS
# =========================
def fourth_friday_of_november(year):
    nov_days = pd.date_range(start=f"{year}-11-01", end=f"{year}-11-30", freq="D")
    fridays = nov_days[nov_days.weekday == 4]
    return fridays[3]

years = [2022, 2023, 2024]

pre_christmas = pd.DataFrame({
    "holiday": "pre_christmas",
    "ds": pd.to_datetime([f"{y}-12-23" for y in years]),
    "lower_window": -22,
    "upper_window": 0
})

black_friday = pd.DataFrame({
    "holiday": "black_friday",
    "ds": pd.to_datetime([fourth_friday_of_november(y) for y in years]),
    "lower_window": 0,
    "upper_window": 3
})

holidays_df = pd.concat([pre_christmas, black_friday], ignore_index=True)

print("\n--- CUSTOM HOLIDAYS ---")
print(holidays_df)

# =========================
# 8. PROPHET MODEL
# =========================
model = Prophet(
    holidays=holidays_df,
    growth="linear",
    yearly_seasonality=True,
    weekly_seasonality=True,
    daily_seasonality=False,
    seasonality_mode="additive",
    changepoint_prior_scale=0.001,
    seasonality_prior_scale=30.0
)

model.add_country_holidays(country_name="SK")
model.fit(train_daily[["ds", "y"]])

print("\n--- MODEL NAFITOVANY ---")

# =========================
# 9. FORECAST NA ROK 2024
# =========================
future_2024 = pd.DataFrame({
    "ds": pd.date_range(start="2024-01-01", end="2024-12-31", freq="D")
})

forecast_2024 = model.predict(future_2024)

# spatna transformacia z log skaly
forecast_2024["prophet_forecast_daily"] = np.expm1(forecast_2024["yhat"])
forecast_2024["prophet_forecast_daily"] = forecast_2024["prophet_forecast_daily"].clip(lower=0)

print("\n--- DIAGNOSTIKA FORECASTU PO SPATNEJ TRANSFORMACII ---")
print("Minimum denny forecast:", forecast_2024["prophet_forecast_daily"].min())
print("Maximum denny forecast:", forecast_2024["prophet_forecast_daily"].max())

forecast_2024["month"] = forecast_2024["ds"].dt.to_period("M").dt.to_timestamp()

prophet_monthly = (
    forecast_2024.groupby("month", as_index=False)["prophet_forecast_daily"]
    .sum()
    .rename(columns={"prophet_forecast_daily": "prophet_forecast"})
    .sort_values("month")
    .reset_index(drop=True)
)

print("\n--- PROPHET FORECAST 2024 NA MESACNEJ UROVNI ---")
print(prophet_monthly)

# =========================
# 10. FINALNA TABULKA V ROVNAKEJ FORME AKO BENCHMARK
# =========================
prophet_comparison = actual_2024.merge(
    prophet_monthly,
    on="month",
    how="left"
).sort_values("month").reset_index(drop=True)

print("\n--- FINALNA POROVNAVACIA TABULKA PRE PROPHET ---")
print(prophet_comparison)

if prophet_comparison.empty:
    raise ValueError("Finalna Prophet tabulka je prazdna.")

# =========================
# 11. ULOZENIE VYSTUPU
# =========================
output_path = input_path.parent / "prophet_segment_B_comparison.csv"
prophet_comparison.to_csv(output_path, index=False, encoding="utf-8-sig")

print("\nSubor ulozeny do:")
print(output_path)

# =========================
# 12. METRIKY PRE PROPHET
# =========================
def mae(actual, forecast):
    actual = np.array(actual, dtype=float)
    forecast = np.array(forecast, dtype=float)
    return np.mean(np.abs(actual - forecast))

def rmse(actual, forecast):
    actual = np.array(actual, dtype=float)
    forecast = np.array(forecast, dtype=float)
    return np.sqrt(np.mean((actual - forecast) ** 2))

def wape(actual, forecast):
    actual = np.array(actual, dtype=float)
    forecast = np.array(forecast, dtype=float)
    if np.sum(actual) == 0:
        return np.nan
    return np.sum(np.abs(actual - forecast)) / np.sum(actual) * 100

prophet_mae = mae(prophet_comparison["actual_sales"], prophet_comparison["prophet_forecast"])
prophet_rmse = rmse(prophet_comparison["actual_sales"], prophet_comparison["prophet_forecast"])
prophet_wape = wape(prophet_comparison["actual_sales"], prophet_comparison["prophet_forecast"])

print("\n--- METRIKY PRE PROPHET ---")
print("MAE:", round(prophet_mae, 2))
print("RMSE:", round(prophet_rmse, 2))
print("WAPE:", round(prophet_wape, 2))

output_path = input_path.parent / "prophet_segment_B_comparison.csv"

