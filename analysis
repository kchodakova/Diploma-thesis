rfm analyza cela

# =========================================================
# KONFIGURÁCIA
# =========================================================
FILE_PATH = r"C:\Users\kajka\Documents\Diplomka\Dáta\Used data\training_period_2022_2023.csv"
OUTPUT_PATH = r"C:\Users\kajka\Documents\Diplomka\Dáta\Used data\rfm_customers_optimized.csv"

ENCODING = "utf-8"
SEP = None                  # napr. "," alebo ";" ; ak nevieš, nechaj None
DECIMAL = "."               # zmeň na "," ak máš čísla typu 12,50
DATE_FORMAT = None          # napr. "%Y-%m-%d" alebo "%d.%m.%Y"; ak nevieš, nechaj None

CHUNKSIZE = 1_000_000
PARTIAL_MERGE_EVERY = 5
EXCLUDE_NON_POSITIVE_LINE_TOTAL = False

# =========================================================
# POMOCNÉ FUNKCIE
# =========================================================
def detect_separator(file_path, encoding="utf-8"):
    with open(file_path, "r", encoding=encoding, newline="") as f:
        sample = f.read(20000)
    try:
        dialect = csv.Sniffer().sniff(sample, delimiters=",;\t|")
        return dialect.delimiter
    except Exception:
        return ","

def clean_line_total(series, decimal="."):
    s = series.astype("string").str.strip()
    s = s.str.replace("\xa0", "", regex=False)
    s = s.str.replace(" ", "", regex=False)

    if decimal == ",":
        s = s.str.replace(".", "", regex=False)
        s = s.str.replace(",", ".", regex=False)
    else:
        s = s.str.replace(",", "", regex=False)

    return pd.to_numeric(s, errors="coerce")

def parse_dates(series, date_format=None):
    if date_format:
        return pd.to_datetime(series, format=date_format, errors="coerce")
    return pd.to_datetime(series, errors="coerce")

def consolidate_order_partials(partials):
    if not partials:
        return []

    df = pd.concat(partials, ignore_index=True)

    df = (
        df.groupby(["customer_id", "order_id"], as_index=False, sort=False)
          .agg(
              transaction_date=("transaction_date", "max"),
              line_total=("line_total", "sum")
          )
    )

    return [df]

def qcut_score(series, reverse=False):
    ranked = series.rank(method="first")
    if reverse:
        return pd.qcut(ranked, 5, labels=[5, 4, 3, 2, 1]).astype("int8")
    return pd.qcut(ranked, 5, labels=[1, 2, 3, 4, 5]).astype("int8")

def assign_segment(row):
    r = row["R_score"]
    f = row["F_score"]
    m = row["M_score"]

    if r >= 4 and f >= 4 and m >= 4:
        return "Champions"
    elif r >= 3 and f >= 4 and m >= 3:
        return "Loyal Customers"
    elif r == 5 and f == 1:
        return "Recent Customers"
    elif r >= 4 and f <= 2:
        return "New Customers"
    elif r >= 3 and f >= 2 and m >= 2:
        return "Potential Loyalists"
    elif r <= 2 and f >= 4 and m >= 3:
        return "At Risk"
    elif r <= 2 and f <= 2 and m >= 3:
        return "Cannot Lose Them"
    elif r <= 2 and f <= 2 and m <= 2:
        return "Hibernating"
    else:
        return "Others"

# =========================================================
# HLAVNÝ KÓD
# =========================================================
start_time = time.time()

if SEP is None:
    SEP = detect_separator(FILE_PATH, encoding=ENCODING)

print(f"Použitý separator: {repr(SEP)}")

usecols = ["customer_id", "order_id", "line_total", "transaction_date"]

dtype_map = {
    "customer_id": "string",
    "order_id": "string",
    "line_total": "string",
    "transaction_date": "string"
}

order_partials = []
chunk_counter = 0
raw_rows_processed = 0
total_failed_dates = 0
failed_date_examples = set()

reader = pd.read_csv(
    FILE_PATH,
    sep=SEP,
    usecols=usecols,
    dtype=dtype_map,
    chunksize=CHUNKSIZE,
    encoding=ENCODING,
    low_memory=True
)

for chunk in reader:
    chunk_counter += 1
    raw_rows_processed += len(chunk)

    raw_dates = chunk["transaction_date"].copy()
    parsed_dates = parse_dates(raw_dates, date_format=DATE_FORMAT)

    failed_mask = raw_dates.notna() & parsed_dates.isna()
    failed_count = int(failed_mask.sum())
    total_failed_dates += failed_count

    if failed_count > 0 and len(failed_date_examples) < 20:
        examples = raw_dates[failed_mask].drop_duplicates().head(20).tolist()
        failed_date_examples.update(examples)

    chunk["transaction_date"] = parsed_dates
    chunk["line_total"] = clean_line_total(chunk["line_total"], decimal=DECIMAL)

    chunk = chunk.dropna(subset=["customer_id", "order_id", "transaction_date", "line_total"])

    if EXCLUDE_NON_POSITIVE_LINE_TOTAL:
        chunk = chunk[chunk["line_total"] > 0]

    order_chunk = (
        chunk.groupby(["customer_id", "order_id"], as_index=False, sort=False)
             .agg(
                 transaction_date=("transaction_date", "max"),
                 line_total=("line_total", "sum")
             )
    )

    order_partials.append(order_chunk)

    if len(order_partials) >= PARTIAL_MERGE_EVERY:
        order_partials = consolidate_order_partials(order_partials)

    del chunk, order_chunk, raw_dates, parsed_dates, failed_mask
    gc.collect()

    print(f"Chunk {chunk_counter} spracovaný | raw rows: {raw_rows_processed:,}")

order_partials = consolidate_order_partials(order_partials)
orders = order_partials[0]

print(f"\nPočet order-level riadkov po redukcii: {len(orders):,}")

snapshot_date = orders["transaction_date"].max() + pd.Timedelta(days=1)

rfm = (
    orders.groupby("customer_id", as_index=False, sort=False)
          .agg(
              Recency=("transaction_date", lambda x: (snapshot_date - x.max()).days),
              Frequency=("order_id", "count"),
              Monetary=("line_total", "sum")
          )
)

rfm["R_score"] = qcut_score(rfm["Recency"], reverse=True)
rfm["F_score"] = qcut_score(rfm["Frequency"], reverse=False)
rfm["M_score"] = qcut_score(rfm["Monetary"], reverse=False)

rfm["RFM_score"] = (
    rfm["R_score"].astype(str) +
    rfm["F_score"].astype(str) +
    rfm["M_score"].astype(str)
)

rfm["RFM_sum"] = (
    rfm["R_score"].astype("int16") +
    rfm["F_score"].astype("int16") +
    rfm["M_score"].astype("int16")
)

rfm["Segment"] = rfm.apply(assign_segment, axis=1)

rfm.to_csv(OUTPUT_PATH, index=False, encoding="utf-8-sig")

elapsed = time.time() - start_time

print("\n==============================")
print("HOTOVO")
print("==============================")
print(f"Spracovaných raw riadkov: {raw_rows_processed:,}")
print(f"Počet order-level riadkov: {len(orders):,}")
print(f"Počet zákazníkov v RFM: {len(rfm):,}")
print(f"Nepodarilo sa parse-núť dátumov: {total_failed_dates:,}")

if total_failed_dates > 0:
    print("Ukážka problematických dátumov:")
    for x in list(failed_date_examples)[:20]:
        print(x)

print(f"Min transaction_date: {orders['transaction_date'].min()}")
print(f"Max transaction_date: {orders['transaction_date'].max()}")
print(f"Výstup uložený do: {OUTPUT_PATH}")
print(f"Trvanie: {elapsed:.2f} sekúnd")

print("\nUkážka výsledku:")
print(rfm.head())

print("\nPočet zákazníkov podľa segmentu:")
print(rfm["Segment"].value_counts())
