file_path = r"C:\Users\kajka\Documents\Diplomka\Dáta\Used data\daily_sales_series_2022_2024.csv"
df = pd.read_csv(file_path)

# Column names
date_col = "transaction_date"
revenue_col = "daily_sales"

# Prepare date column
df[date_col] = pd.to_datetime(df[date_col])

# Filter analysed period: 2022–2024
eda_df = df[
    (df[date_col] >= "2022-01-01") &
    (df[date_col] <= "2024-12-31")
].copy()

# Create time variables
eda_df["year"] = eda_df[date_col].dt.year
eda_df["month"] = eda_df[date_col].dt.month
eda_df["month_name"] = eda_df[date_col].dt.month_name()

# Normalize daily sales within each year
eda_df["year_avg_revenue"] = eda_df.groupby("year")[revenue_col].transform("mean")
eda_df["revenue_index"] = eda_df[revenue_col] / eda_df["year_avg_revenue"] * 100

# Monthly descriptive summary
monthly_summary = (
    eda_df.groupby("month")
    .agg(
        month_name=("month_name", "first"),
        n_days=(revenue_col, "count"),
        avg_revenue=(revenue_col, "mean"),
        median_revenue=(revenue_col, "median"),
        avg_revenue_index=("revenue_index", "mean"),
        median_revenue_index=("revenue_index", "median")
    )
    .reset_index()
)

monthly_summary[
    ["avg_revenue", "median_revenue", "avg_revenue_index", "median_revenue_index"]
] = monthly_summary[
    ["avg_revenue", "median_revenue", "avg_revenue_index", "median_revenue_index"]
].round(2)

# Kruskal-Wallis test for monthly differences
monthly_groups = [
    group["revenue_index"].dropna().values
    for _, group in eda_df.groupby("month")
]

kw_stat, kw_p = kruskal(*monthly_groups)

# Test result table
monthly_test_result = pd.DataFrame({
    "Test area": ["Monthly differences"],
    "Period": ["2022-01-01 to 2024-12-31"],
    "Variable": ["Year-normalized daily revenue"],
    "Grouping variable": ["Calendar month"],
    "Test used": ["Kruskal-Wallis"],
    "Test statistic": [round(kw_stat, 3)],
    "p-value": ["< 0.001" if kw_p < 0.001 else round(kw_p, 4)],
    "Conclusion": [
        "Statistically significant" if kw_p < 0.05 else "Not statistically significant"
    ]
})

# Print results
print("\nMonthly revenue summary:")
print(monthly_summary.to_string(index=False))

print("\nKruskal-Wallis test result:")
print(monthly_test_result.to_string(index=False))

print("\nInterpretation:")
if kw_p < 0.05:
    print(
        f"The Kruskal-Wallis test indicated statistically significant differences "
        f"in year-normalized daily revenue across calendar months "
        f"(H = {kw_stat:.3f}, p < 0.001)."
    )
else:
    print(
        f"The Kruskal-Wallis test did not indicate statistically significant differences "
