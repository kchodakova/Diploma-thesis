# =========================
# 8. PROPHET MODEL
# =========================
model = Prophet(
    holidays=holidays_df,
    growth="linear",
    yearly_seasonality=True,
    weekly_seasonality=True,
    daily_seasonality=False,
    seasonality_mode="additive",
    changepoint_prior_scale=0.001,
    seasonality_prior_scale=30.0
)

model.add_country_holidays(country_name="SK")
model.fit(train_daily[["ds", "y"]])

print("\n--- MODEL NAFITOVANY ---")

# =========================
# 9. FORECAST NA ROK 2024
# =========================
future_2024 = pd.DataFrame({
    "ds": pd.date_range(start="2024-01-01", end="2024-12-31", freq="D")
})

forecast_2024 = model.predict(future_2024)

# spatna transformacia z log skaly
forecast_2024["prophet_forecast_daily"] = np.expm1(forecast_2024["yhat"])
forecast_2024["prophet_forecast_daily"] = forecast_2024["prophet_forecast_daily"].clip(lower=0)

print("\n--- DIAGNOSTIKA FORECASTU PO SPATNEJ TRANSFORMACII ---")
print("Minimum denny forecast:", forecast_2024["prophet_forecast_daily"].min())
print("Maximum denny forecast:", forecast_2024["prophet_forecast_daily"].max())

forecast_2024["month"] = forecast_2024["ds"].dt.to_period("M").dt.to_timestamp()

prophet_monthly = (
    forecast_2024.groupby("month", as_index=False)["prophet_forecast_daily"]
    .sum()
    .rename(columns={"prophet_forecast_daily": "prophet_forecast"})
    .sort_values("month")
    .reset_index(drop=True)
)

print("\n--- PROPHET FORECAST 2024 NA MESACNEJ UROVNI ---")
print(prophet_monthly)

# =========================
# 10. FINALNA TABULKA V ROVNAKEJ FORME AKO BENCHMARK
# =========================
prophet_comparison = actual_2024.merge(
    prophet_monthly,
    on="month",
    how="left"
).sort_values("month").reset_index(drop=True)

print("\n--- FINALNA POROVNAVACIA TABULKA PRE PROPHET ---")
print(prophet_comparison)

if prophet_comparison.empty:
    raise ValueError("Finalna Prophet tabulka je prazdna.")

# =========================
