    {"holiday": "black_friday_period", "ds": get_black_friday(2022), "lower_window": 0, "upper_window": 3},
    {"holiday": "black_friday_period", "ds": get_black_friday(2023), "lower_window": 0, "upper_window": 3},
    {"holiday": "black_friday_period", "ds": get_black_friday(2024), "lower_window": 0, "upper_window": 3},
    {"holiday": "pre_christmas_period", "ds": pd.Timestamp("2022-12-23"), "lower_window": -22, "upper_window": 0},
    {"holiday": "pre_christmas_period", "ds": pd.Timestamp("2023-12-23"), "lower_window": -22, "upper_window": 0},
    {"holiday": "pre_christmas_period", "ds": pd.Timestamp("2024-12-23"), "lower_window": -22, "upper_window": 0},
])

# 4. Rolling validation mesiace
validation_month_starts = pd.date_range(start="2023-01-01", end="2023-12-01", freq="MS")

# 5. Parametre na test
param_grid = {
    "seasonality_mode": ["additive", "multiplicative"],
    "changepoint_prior_scale": [0.001, 0.01, 0.05, 0.1],
    "seasonality_prior_scale": [1.0, 5.0, 10.0, 20.0]
}

all_results = []

for seasonality_mode, changepoint_prior_scale, seasonality_prior_scale in product(
    param_grid["seasonality_mode"],
    param_grid["changepoint_prior_scale"],
    param_grid["seasonality_prior_scale"]
):
    abs_errors = []
    sq_errors = []
    total_actual = 0.0

    failed = False

    for month_start in validation_month_starts:
        month_end = month_start + pd.offsets.MonthEnd(1)
        train_end = month_start - pd.Timedelta(days=1)

        train_df = daily_df[
            (daily_df["transaction_date"] >= "2022-01-01") &
            (daily_df["transaction_date"] <= train_end)
        ].copy()

        # ochrana pred nulami / zápornými hodnotami
        if (train_df["daily_sales"] <= 0).any():
            failed = True
            break

        prophet_train = train_df.rename(columns={
            "transaction_date": "ds",
            "daily_sales": "y"
        })[["ds", "y"]].copy()

        prophet_train["y"] = np.log(prophet_train["y"])

        model = Prophet(
            holidays=custom_holidays,
            yearly_seasonality=True,
            weekly_seasonality=True,
            daily_seasonality=False,
            seasonality_mode=seasonality_mode,
            changepoint_prior_scale=changepoint_prior_scale,
            seasonality_prior_scale=seasonality_prior_scale
        )

        model.add_country_holidays(country_name="SK")
        model.fit(prophet_train)

        periods = (month_end - train_end).days
        future = model.make_future_dataframe(periods=periods, freq="D")
        forecast = model.predict(future)

        forecast["yhat"] = np.exp(forecast["yhat"])

        forecast_month = forecast[
            (forecast["ds"] >= month_start) &
            (forecast["ds"] <= month_end)
        ][["ds", "yhat"]].copy()

        forecast_sum = forecast_month["yhat"].sum()

        actual_sum = daily_df[
            (daily_df["transaction_date"] >= month_start) &
            (daily_df["transaction_date"] <= month_end)
        ]["daily_sales"].sum()

        abs_error = abs(forecast_sum - actual_sum)
        sq_error = (forecast_sum - actual_sum) ** 2

        abs_errors.append(abs_error)
        sq_errors.append(sq_error)
        total_actual += actual_sum

    if failed:
        continue

    mae = np.mean(abs_errors)
    rmse = math.sqrt(np.mean(sq_errors))
    wape = (np.sum(abs_errors) / total_actual) * 100 if total_actual != 0 else np.nan

    all_results.append({
        "seasonality_mode": seasonality_mode,
        "changepoint_prior_scale": changepoint_prior_scale,
        "seasonality_prior_scale": seasonality_prior_scale,
        "cv_mae": mae,
        "cv_rmse": rmse,
        "cv_wape": wape
    })

results_df = pd.DataFrame(all_results).sort_values("cv_wape")
print(results_df)
