from pathlib import Path
import pandas as pd
import numpy as np
from prophet import Prophet

# =========================
# 1. CESTA K PRIPRAVENYM DATAM
# =========================
input_path = Path(r"C:\Users\kajka\Documents\Diplomka\Dáta\Used data\b_segment_forecast_input.csv")

# =========================
# 2. NACITANIE DAT
# =========================
df = pd.read_csv(input_path, encoding="utf-8-sig")

print("\n--- NACITANIE PRIPRAVENYCH DAT ---")
print("Pocet riadkov:", len(df))
print("Stlpce:", df.columns.tolist())

required_cols = {"transaction_date", "line_total"}
missing_cols = required_cols - set(df.columns)

if missing_cols:
    raise ValueError(f"V subore chybaju stlpce: {missing_cols}")

# =========================
# 3. PARSOVANIE
# =========================
df["transaction_date"] = pd.to_datetime(
    df["transaction_date"].astype(str).str.strip(),
    format="%Y-%m-%d",
    errors="coerce"
)

df["line_total"] = pd.to_numeric(df["line_total"], errors="coerce")

print("\n--- KONTROLA PO PARSOVANI ---")
print("Neparsovane datumy:", df["transaction_date"].isna().sum())
print("Neparsovane line_total:", df["line_total"].isna().sum())

df = df.dropna(subset=["transaction_date", "line_total"]).copy()

if df.empty:
    raise ValueError("Po parsovani nezostali ziadne riadky.")

# =========================
# 4. TRAIN A ACTUAL 2024
# =========================
train_raw = df[df["transaction_date"] < "2024-01-01"].copy()
actual_2024_raw = df[
    (df["transaction_date"] >= "2024-01-01") &
    (df["transaction_date"] <= "2024-12-31")
].copy()

print("\n--- ROZDELENIE DAT ---")
print("Train riadky (2022-2023):", len(train_raw))
print("Actual 2024 riadky:", len(actual_2024_raw))

if train_raw.empty:
    raise ValueError("Train dataset je prazdny.")

if actual_2024_raw.empty:
    raise ValueError("Actual 2024 dataset je prazdny.")

# =========================
# 5. DENNA CASOVA RADA PRE PROPHET
# =========================
train_daily = (
    train_raw.assign(ds=train_raw["transaction_date"].dt.normalize())
    .groupby("ds", as_index=False)["line_total"]
    .sum()
    .rename(columns={"line_total": "y"})
)

full_train_dates = pd.DataFrame({
    "ds": pd.date_range(start=train_daily["ds"].min(), end="2023-12-31", freq="D")
})

train_daily = full_train_dates.merge(train_daily, on="ds", how="left")
train_daily["y"] = train_daily["y"].fillna(0)

print("\n--- DENNA CASOVA RADA PRE PROPHET PRED LOG TRANSFORMACIOU ---")
print("Pocet riadkov:", len(train_daily))
print("Obdobie:", train_daily["ds"].min(), "->", train_daily["ds"].max())
print(train_daily.head())

# log transformacia
train_daily["y"] = np.log1p(train_daily["y"])

print("\n--- DENNA CASOVA RADA PRE PROPHET PO LOG TRANSFORMACII ---")
print(train_daily.head())

# =========================
# 6. ACTUAL 2024 NA MESACNEJ UROVNI
# =========================
actual_2024_raw["month"] = actual_2024_raw["transaction_date"].dt.to_period("M").dt.to_timestamp()

actual_2024 = (
    actual_2024_raw.groupby("month", as_index=False)["line_total"]
    .sum()
    .rename(columns={"line_total": "actual_sales"})
    .sort_values("month")
    .reset_index(drop=True)
)

print("\n--- ACTUAL 2024 ---")
print(actual_2024)

# =========================
# 7. CUSTOM HOLIDAYS
# =========================
def fourth_friday_of_november(year):
    nov_days = pd.date_range(start=f"{year}-11-01", end=f"{year}-11-30", freq="D")
    fridays = nov_days[nov_days.weekday == 4]
    return fridays[3]

years = [2022, 2023, 2024]

pre_christmas = pd.DataFrame({
    "holiday": "pre_christmas",
    "ds": pd.to_datetime([f"{y}-12-23" for y in years]),
    "lower_window": -22,
    "upper_window": 0
})

black_friday = pd.DataFrame({
    "holiday": "black_friday",
    "ds": pd.to_datetime([fourth_friday_of_november(y) for y in years]),
    "lower_window": 0,
    "upper_window": 3
})

holidays_df = pd.concat([pre_christmas, black_friday], ignore_index=True)

print("\n--- CUSTOM HOLIDAYS ---")
