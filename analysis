def load_csv_flexible(path):
    separators = [";", ",", "\t"]
    encodings = ["utf-8-sig", "utf-8", "cp1250", "latin1"]

    last_error = None

    for enc in encodings:
        for sep in separators:
            try:
                df = pd.read_csv(path, sep=sep, encoding=enc)
                df.columns = df.columns.str.strip().str.lower()

                if len(df.columns) > 1:
                    print(f"\nSubor {path.name} nacitany so sep='{sep}' a encoding='{enc}'")
                    print("Stlpce:", df.columns.tolist())
                    return df
            except Exception as e:
                last_error = e

    raise ValueError(f"Nepodarilo sa nacitat subor {path}. Posledna chyba: {last_error}")


def normalize_id_value(x):
    if pd.isna(x):
        return None
    x = str(x)
    x = unicodedata.normalize("NFKC", x)
    x = x.replace("\u00A0", " ")
    x = x.replace("–", "-").replace("—", "-").replace("−", "-")
    x = x.strip().upper()
    x = "".join(x.split())
    return x


def parse_line_total(series):
    s = series.astype(str).str.strip()

    s = s.str.replace("\u00A0", "", regex=False)
    s = s.str.replace(" ", "", regex=False)
    s = s.str.replace("€", "", regex=False)

    mask_eu = s.str.contains(",", na=False)
    s.loc[mask_eu] = (
        s.loc[mask_eu]
        .str.replace(".", "", regex=False)
        .str.replace(",", ".", regex=False)
    )

    return pd.to_numeric(s, errors="coerce")


