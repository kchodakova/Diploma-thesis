# 3. Tréningové obdobie 2022–2023
train_df = daily_df[
    (daily_df["transaction_date"] >= "2022-01-01") &
    (daily_df["transaction_date"] <= "2023-12-31")
].copy()

# 4. Premenovanie stĺpcov pre Prophet
prophet_train = train_df.rename(columns={
    "transaction_date": "ds",
    "daily_sales": "y"
})

# --- ZMENA 2: Logaritmická transformácia cieľovej premennej ---
prophet_train["y"] = np.log(prophet_train["y"])

print(prophet_train.head())
print(prophet_train.tail())
print(prophet_train.columns.tolist())
print(prophet_train.shape)

# 5. Funkcia na výpočet Black Friday
def get_black_friday(year):
    november = pd.date_range(start=f"{year}-11-01", end=f"{year}-11-30", freq="D")
    thursdays = november[november.weekday == 3]  # Thursday = 3
    thanksgiving = thursdays[3]                  # 4th Thursday in November
    black_friday = thanksgiving + pd.Timedelta(days=1)
    return black_friday

# 6. Custom holiday effects
custom_holidays = pd.DataFrame([
    {"holiday": "black_friday_period", "ds": get_black_friday(2022), "lower_window": 0, "upper_window": 3},
    {"holiday": "black_friday_period", "ds": get_black_friday(2023), "lower_window": 0, "upper_window": 3},
    {"holiday": "black_friday_period", "ds": get_black_friday(2024), "lower_window": 0, "upper_window": 3},

    {"holiday": "pre_christmas_period", "ds": pd.Timestamp("2022-12-23"), "lower_window": -22, "upper_window": 0},
    {"holiday": "pre_christmas_period", "ds": pd.Timestamp("2023-12-23"), "lower_window": -22, "upper_window": 0},
    {"holiday": "pre_christmas_period", "ds": pd.Timestamp("2024-12-23"), "lower_window": -22, "upper_window": 0},
])

print(custom_holidays)

# 7. Vytvorenie Prophet modelu
# --- ZMENA 3: Zmena seasonality_mode na "additive" ---
model = Prophet(
    holidays=custom_holidays,
    yearly_seasonality=True,
    weekly_seasonality=True,
    daily_seasonality=False,
    seasonality_mode="additive",
    changepoint_prior_scale=0.01,
    seasonality_prior_scale=10.0
)

model.add_country_holidays(country_name="SK")

